{
    "name":  "@marketplace/shared",
    "version":  "0.0.1",
    "private":  true,
    "description":  "Shared types, constants, Zod schemas, and utilities for the marketplace",
    "main":  "src/index.ts",
    "exports":  {
                    ".":  "./src/index.ts",
                    "./types":  "./src/types/index.ts",
                    "./constants":  "./src/constants/index.ts",
                    "./schemas":  "./src/schemas/index.ts",
                    "./utils":  "./src/utils/index.ts"
                },
    "scripts":  {
                    "typecheck":  "tsc --noEmit",
                    "build":  "tsc --project tsconfig.json",
                    "clean":  "rm -rf dist"
                },
    "dependencies":  {
                         "zod":  "^3.23.0"
                     },
    "devDependencies":  {
                            "@marketplace/typescript-config":  "workspace:*",
                            "typescript":  "^5.4.0"
                        }
}
