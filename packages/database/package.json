{
  "name": "@marketplace/database",
  "version": "0.0.1",
  "private": true,
  "description": "Drizzle ORM schema and migration tooling for the marketplace database",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@marketplace/env": "workspace:*",
    "@marketplace/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
