# ============================================================
# Amazon-Style Marketplace — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are validated via Zod in packages/env/src/server.ts
# NEVER commit .env to git.
# ============================================================

# ---- Database -------------------------------------------------------
# PostgreSQL connection string (Neon or local)
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace

# PgBoss uses the same DB by default; override only if using a separate DB
PG_BOSS_DATABASE_URL=postgresql://user:password@localhost:5432/marketplace

# ---- Redis ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Application ----------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Authentication -------------------------------------------------
# Strong random strings — generate with: openssl rand -base64 64
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64
SESSION_SECRET=change-me-in-production-use-openssl-rand-base64-64
COOKIE_SECRET=change-me-in-production-use-openssl-rand-base64-64

# Session duration in seconds (default: 7 days)
SESSION_TTL_SECONDS=604800

# ---- AI / OpenAI ----------------------------------------------------
OPENAI_API_KEY=sk-...
# Model used for chat/shopping assistant
OPENAI_MODEL=gpt-4o-mini
# Model used for embedding generation
EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimensions (must match pgvector column size)
EMBEDDING_DIMENSIONS=1536

# ---- Payments -------------------------------------------------------
# Provider: cod | stripe | paystack
PAYMENT_PROVIDER=cod
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ---- Object Storage (S3-compatible) ----------------------------------------
# Provider: "minio" for local dev, "r2" for Cloudflare R2 in production, "s3" for AWS
STORAGE_PROVIDER=minio

# MinIO local dev (docker-compose):
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=marketplace
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# Public base URL for image URLs returned in API responses
# MinIO local: http://localhost:9000/marketplace
# R2 production example: https://<account_id>.r2.cloudflarestorage.com/marketplace
#   or with custom domain: https://assets.yourdomain.com
STORAGE_PUBLIC_URL=http://localhost:9000/marketplace
# Max upload size in bytes (default 10 MB)
STORAGE_MAX_SIZE_BYTES=10485760

# Cloudflare R2 production config (fill in when deploying):
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_BUCKET=marketplace
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# STORAGE_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# STORAGE_PUBLIC_URL=https://assets.yourdomain.com

# ---- Logging --------------------------------------------------------
# Levels: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_PRETTY=true

# ---- Rate Limiting --------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Stricter limits for auth routes
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
