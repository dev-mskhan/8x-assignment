{
  "name": "@marketplace/server",
  "version": "0.0.1",
  "private": true,
  "description": "Marketplace API server and worker process",
  "main": "dist/apps/server/src/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/workers/register-workers.ts",
    "start": "node dist/apps/server/src/main.js",
    "start:worker": "node dist/apps/server/src/workers/register-workers.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db-migrate.ts",
    "db:seed": "tsx src/db-seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/sensible": "^5.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "^10.0.0",
    "@marketplace/database": "workspace:*",
    "@marketplace/env": "workspace:*",
    "@marketplace/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pg-boss": "^9.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@marketplace/eslint-config": "workspace:*",
    "@marketplace/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "drizzle-kit": "^0.21.0",
    "eslint": "^8.57.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
