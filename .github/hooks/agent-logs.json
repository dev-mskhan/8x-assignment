{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/capture-agent-session.ps1 -Event userPromptSubmitted",
        "comment": "Capture submitted prompts for the session log"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/capture-agent-session.ps1 -Event agentStop",
        "comment": "Capture only final responses for the session log"
      }
    ]
  }
}
